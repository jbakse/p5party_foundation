{
  "name": "p5party_foundation",
  "version": "0.0.1",
  "description": "Project template for more complex p5.party games",
  "author": "Justin Bakse",
  "license": "MIT",
  "scripts": {
    "slice-players-base": "aseprite -b ./production/players.aseprite --scale 5 --save-as ./src/generated/players/{slice}/base.png",
    "slice-players-light": "aseprite -b --layer 'light' ./production/players.aseprite --scale 5 --save-as ./src/generated/players/{slice}/light.png",
    "slice-items": "aseprite -b ./production/items.aseprite --scale 5 --save-as ./src/generated/items/{slice}.png",
    "slice-map": "aseprite -b ./production/tile_map.aseprite --scale 5 --save-as ./src/generated/tile_map/{slice}.png",
    "slice-ground": "aseprite -b ./production/ground.aseprite --scale 5 --save-as ./src/generated/ground/{slice}.png",
    "slice-players": "npm run slice-players-base && npm run slice-players-light",
    "slice-all": "npm run slice-players && npm run slice-items && npm run slice-map && npm run slice-ground"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-p5js": "^1.1.0",
    "globals": "^16.0.0"
  }
}
